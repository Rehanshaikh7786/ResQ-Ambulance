# Copy this file to ".env" and fill in what you have. Everything is optional – the app runs without any of it.

# Maps work out of the box with OpenStreetMap (no key). To use Google Maps instead, set MAP_PROVIDER=google and add a key
# (enable Maps JavaScript API + Directions API and billing in Google Cloud).
# MAP_PROVIDER=google
GOOGLE_MAPS_API_KEY=
# Use your own tile server instead of OpenStreetMap, e.g. https://tiles.example.com/{z}/{x}/{y}.png
# SOS_TILE_URL=

# Anthropic API key -> real AI injury detection from photos (Claude vision). Without it a basic local colour check is used.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Protect Control Room / Hospital Desk / Driver pages with a PIN (leave empty for open demo mode)
STAFF_PIN=

# Seconds a hospital has to reply before the next hospital is alerted (default 60)
# SOS_ALERT_TIMEOUT=60
# Demo mode: simulated hospital staff auto-reply after this many seconds (default 8)
# SOS_AUTO_DELAY=8
PORT=8000
